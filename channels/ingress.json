{
  "routes": [
    {
      "path": "events-twilio",
      "kind": "http",
      "description": "Inbound SMS webhooks from a Twilio number (messaging deliveries).",
      "verification": {
        "kind": "hmac",
        "algorithm": "sha1",
        "secret": {
          "field": "auth_token"
        },
        "signature": {
          "header": "X-Twilio-Signature",
          "encoding": "base64"
        },
        "payload": ["request-url", "form-params"]
      },
      "inbound": {
        "identity": "phone",
        "fields": {
          "content": "Body",
          "conversationExternalId": "From",
          "externalMessageId": "MessageSid",
          "actorExternalId": "From",
          "chatType": {
            "from": "From",
            "default": "sms"
          }
        }
      }
    }
  ]
}
